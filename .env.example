# ==============================================================================
# Dispatch Environment Configuration
# Copy this file to .env.local and fill in your values before starting the app.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for saving digests and LangGraph state.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ------------------------------------------------------------------------------
# LLM Providers (AT LEAST ONE REQUIRED)
# ------------------------------------------------------------------------------
# The system supports multiple LLM providers. You only need to provide an API key
# for the provider(s) you wish to use. The system prioritizes Gemini by default.

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# Data Source APIs (OPTIONAL)
# ------------------------------------------------------------------------------
# Some MCP tools require API keys. If you don't provide them, the tools will 
# either fail gracefully or run in a limited/demo mode (depending on the API).

# US Congress (GovInfo)
CONGRESS_GOV_API_KEY=DEMO_KEY

# US Regulations.gov (Data.gov)
REGULATIONS_GOV_API_KEY=DEMO_KEY

# SEC EDGAR (Requires a valid user agent format: Name email@example.com)
SEC_API_USER_AGENT="Your Name your.email@example.com"
